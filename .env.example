DB_HOST=localhost
DB_PORT=5432
DB_NAME=epidemic
DB_USER=spark_writer
DB_PASSWORD=change-me

# epidemic-alert-service (only needed when running alert/alert_service.py locally)
DATABASE_URL=postgresql://spark_writer:change-me@localhost:5432/epidemic
ALERT_POLL_SECONDS=300
ALERT_COOLDOWN_SECONDS=1800
ESCALATE_AFTER_SECONDS=7200
ALERT_RULES_PATH=alert/thresholds.json

# Slack delivery (optional locally)
SLACK_ENABLED=0
SLACK_WEBHOOK_URL=
SLACK_CHANNEL_NAME=#epidemic-alerts
SLACK_CRITICAL_MENTION=<!channel>
SLACK_NOTIFY_SEVERITIES=critical,warning
SLACK_TIMEOUT_SECONDS=5
